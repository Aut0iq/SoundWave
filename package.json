{
  "name": "soundwave",
  "private": true,
  "version": "0.3.0",
  "description": "Преобразование голоса и гитары в MIDI в реальном времени: распознавание высоты тона, вокальные триггеры, многодорожечная запись, автотюн и интеграция с FL Studio.",
  "author": "Aut0iq",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aut0iq/SoundWave.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
